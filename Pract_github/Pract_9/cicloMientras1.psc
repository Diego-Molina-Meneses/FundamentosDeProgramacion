Algoritmo cicloMientras1
	
    Definir ciclo, num Como Entero
	
    Escribir "introduce el numero de la tabla a desplegar"
    Leer num
	
    ciclo <- 1
	
    Mientras ciclo <= 10 Hacer
        Escribir num, " * ", ciclo, " = ", (ciclo * num)
        ciclo <- ciclo + 1
    FinMientras
	
FinAlgoritmo
