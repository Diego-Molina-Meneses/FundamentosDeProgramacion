Algoritmo PositivoNegativo
	Definir num Como Entero
	
	Escribir "Introduce un numero: "
	Leer num
	
	Mientras num <> 0 Hacer
		
		Si num > 0 Entonces
			Escribir "Positivo"
		SiNo
			Escribir "Negativo"
		FinSi
		
		Escribir "Introduce otro numero: "
		Leer num
		
	FinMientras
	
	Escribir "Programa terminado."
FinAlgoritmo
