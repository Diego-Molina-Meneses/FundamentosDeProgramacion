Algoritmo NumeroMayor
	
	Definir n1, n2 Como Entero
	
	Escribir "Introduce un numero: "
	Leer n1
	
	Escribir "Introduce otro numero: "
	Leer n2
	
	// Si ambos numeros son iguales diria que n2 es mayor que n1
	Si n1 > n2 Entonces
		Escribir n1, " es mayor que ", n2
	SiNo
		Escribir n2, " es mayor que ", n1
	FinSi
	
FinAlgoritmo
