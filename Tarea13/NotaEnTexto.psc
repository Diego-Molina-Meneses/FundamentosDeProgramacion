Algoritmo NotaEnTexto
	
	Definir nota Como Entero
	
	Escribir "Introduzca una nota entre 0 y 10: "
	Leer nota
	
	Segun nota Hacer
		
		0:
			Escribir "cero"
		1:
			Escribir "uno"
		2:
			Escribir "dos"
		3:
			Escribir "tres"
		4:
			Escribir "cuatro"
		5:
			Escribir "cinco"
		6:
			Escribir "seis"
		7:
			Escribir "siete"
		8:
			Escribir "ocho"
		9:
			Escribir "nueve"
		10:
			Escribir "diez"
			
		De Otro Modo:
			Escribir "Nota fuera de rango"
			
	FinSegun
	
FinAlgoritmo
